	"Note to maintainers": {
		"prefix": "note",
		"description": "Shortcut for a block comment intended for future maintainers",
		"scope": "lua",
		"body": [
			"--[[",
			"    Note to maintainers:",
			"    $0",
			"--]]",
		]
	},

	"@As Cast": {
		"prefix": "as",
		"description": "Shortcut for --[[@as <type>]]",
		"scope": "lua",
		"body": [
			"--[[@as $0]]"
		]
	},

	"Print": {
		"prefix": "pr",
		"description": "Shortcut for `Section.Print()`",
		"scope": "lua",
		"body": [
			"Section.Print( $0 )"
		]
	},

	"Not Implemented": {
		"prefix": "noi",
		"description": "Shortcut for `typecheck.NotImplementedError()`",
		"scope": "lua",
		"body": [
			"typecheck.NotImplementedError()"
		]
	},

	"C&C Renegade Lua Class": {
		"prefix": "class",
		"description": "A Lua class template that mimics a C++ class, created for porting aspects of Command and Conquer: Renegade to Garry's Mod",
		"isFileTemplate": true,
		"scope": "lua",
		"body": [
			"-- Based on ${1:CppClassName} within ${2:FilePath}.cpp/h",
			"",
			"--- @class Renegade",
			"local CNC = CNC_RENEGADE",
			"",
			"--- @class ${3:LuaClassName}Class",
			"--- @field Instance ${3}Instance The metatable used by ${3}Instance",
			"local STATIC = CNC.CreateExport()",
			"local isHotload = not table.IsEmpty( STATIC )",
			"STATIC.Class = \"${3}Class\"",
			"",
			"--- @class ${3}Instance",
			"--- @field Static ${3}Class The static table for this instance's class",
			"local INSTANCE = robustclass.Register( \"Renegade_${3}\" )",
			"INSTANCE.Class = \"${3}Instance\"",
			"STATIC.Instance = INSTANCE",
			"INSTANCE.Static = STATIC",
			"INSTANCE.Is${3} = true",
			"",
			"",
			"--#region Exported Enums",
			"--#endregion",
			"",
			"",
			"--#region Imports",
			"--#endregion",
			"",
			"",
			"--#region Imported Enums",
			"--#endregion",
			"",
			"",
			"--[[ Static Functions and Variables ]] do",
			"",
			"    --- @class ${3}Class",
			"",
			"    --- Creates a new ${3}Instance",
			"    --- @vararg any",
			"    --- @return ${3}Instance",
			"    function STATIC.New( ... )",
			"        return robustclass.New( \"Renegade_${3}\", ... )",
			"    end",
			"",
			"    --- @param arg any",
			"    --- @return boolean `true` if the passed argument is a(n) ${3}Instance, `false` otherwise",
			"    function STATIC.Is${3}( arg )",
			"        if not istable( arg ) then return false end",
			"        if getmetatable( arg ) ~= INSTANCE then return false end",
			"",
			"        return arg.Is${3} and true or false",
			"    end",
			"",
			"    typecheck.RegisterType( \"${3}Instance\", STATIC.Is${3} )",
			"end",
			"",
			"",
			"--- @class ${3}Instance",
			"",
			"--- Constructs a new ${3}Instance",
			"--- @vararg any",
			"function INSTANCE:Renegade_${3}( ... )",
			"    local args = { ... }",
            "    local argCount = select( \"#\", ... )",
			"",
			"    ${0}",
			"end",
			"",
		]
	},

	"C&C Renegade Lua Static Class": {
		"prefix": "staticclass",
		"description": "A Lua class template that mimics a static C++ class, created for porting aspects of Command and Conquer: Renegade to Garry's Mod",
		"isFileTemplate": true,
		"scope": "lua",
		"body": [
			"-- Based on ${1:CppClassName} within ${2:FilePath}.cpp/h",
			"",
			"--- @class Renegade",
			"local CNC = CNC_RENEGADE",
			"",
			"--- @class ${3:LuaClassName}Class",
			"local STATIC = CNC.CreateExport()",
			"local isHotload = not table.IsEmpty( STATIC )",
			"STATIC.Class = \"${3}Class\"",
			"",
			"",
			"--#region Exported Enums",
			"--#endregion",
			"",
			"",
			"--#region Imports",
			"--#endregion",
			"",
			"",
			"--#region Imported Enums",
			"--#endregion",
			"",
			"",
			"--- @class ${3}Class",
			"",
			"$0",
		]
	},

	"Section": {
		"prefix": "section",
		"description": "A section with a self-contained scope",
		"scope": "lua",
        "body": [
			"--[[ $1 ]] do",
			"    $0",
			"end"
		  ],
	}

    --- @param arg any
    --- @return boolean `true` if the passed argument is a(n) {{InstanceClassName}}, `false` otherwise
    function STATIC.Is{{BaseClassName}}( arg )
        if not istable( arg ) then return false end
        if getmetatable( arg ) ~= INSTANCE then return false end

        return arg.Is{{BaseClassName}} and true or false
    end


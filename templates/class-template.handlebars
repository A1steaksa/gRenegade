    end

    --- @param arg any
    --- @return boolean `true` if the passed argument is a(n) {{LuaInstanceClassName}}, `false` otherwise
    function STATIC.Is{{LuaBaseClassName}}( arg )
        if not istable( arg ) then return false end
        if getmetatable( arg ) ~= INSTANCE then return false end

        return arg.Is{{LuaBaseClassName}} and true or false
    end

    typecheck.RegisterType( "{{LuaInstanceClassName}}", STATIC.Is{{LuaBaseClassName}} )
end


